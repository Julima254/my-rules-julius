<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Life Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<style>
  /* ===== Colors ===== */
:root {
  --dark-blue: #0a2647;
  --mid-blue: #144272;
  --light-blue: #2c74b3;
  --white: #ffffff;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: 'Segoe UI', sans-serif;
}

/* ===== Navbar ===== */
.navbar {
  position: sticky;
  top: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--dark-blue);
  color: var(--white);
  padding: 18px 40px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
  transition: box-shadow 0.3s ease, padding 0.3s ease;
}

.nav-title {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--white);
  letter-spacing: 0.5px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
}

.nav-links a {
  color: var(--white);
  text-decoration: none;
  font-size: 1rem;
  font-weight: 500;
  padding: 8px 4px;
  position: relative;
  transition: color 0.2s ease;
}

.nav-links a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -4px;
  width: 0;
  height: 2px;
  background-color: var(--light-blue);
  transition: width 0.25s ease;
}

.nav-links a:hover {
  color: var(--light-blue);
}

.nav-links a:hover::after {
  width: 100%;
}

/* Logout button */
.nav-links .btn.small.danger {
  background-color: var(--light-blue);
  color: var(--white);
  border: none;
  padding: 8px 16px;
  border-radius: 6px;
  font-size: 0.9rem;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.nav-links .btn.small.danger:hover {
  background-color: #3a8fd1;
}

/* ===== Hamburger (hidden on desktop) ===== */
.hamburger {
  display: none;
  flex-direction: column;
  justify-content: space-between;
  width: 28px;
  height: 20px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  z-index: 1100;
}

.hamburger span {
  display: block;
  height: 3px;
  width: 100%;
  background-color: var(--white);
  border-radius: 2px;
  transition: all 0.3s ease;
}

.hamburger.active span:nth-child(1) {
  transform: translateY(8.5px) rotate(45deg);
}

.hamburger.active span:nth-child(2) {
  opacity: 0;
}

.hamburger.active span:nth-child(3) {
  transform: translateY(-8.5px) rotate(-45deg);
}

/* ===== Mobile view ===== */
@media (max-width: 768px) {
  .navbar {
    padding: 16px 24px;
  }

  .hamburger {
    display: flex;
  }

  .nav-links {
    position: fixed;
    top: 0;
    right: -100%;
    height: 100vh;
    width: 260px;
    background-color: var(--mid-blue);
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 90px 30px;
    gap: 24px;
    transition: right 0.35s ease;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.3);
  }

  .nav-links.open {
    right: 0;
  }

  .nav-links a {
    font-size: 1.1rem;
    width: 100%;
  }

  .nav-links form {
    width: 100%;
    margin-left: 0 !important;
  }

  .nav-links .btn.small.danger {
    width: 100%;
  }
}
</style>
<body>
  <nav class="navbar">
    <div class="nav-title">🧭 My Life Tracker</div>

    <button class="hamburger" id="hamburger" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-links" id="navLinks">
      <a href="/">Dashboard</a>
      <a href="/achievements">Achievements</a>
      <a href="/rules">Rules</a>
      <a href="/career">Career</a>
      <a href="/routine">Routine</a>
      <a href="/theme">Theme</a>
      <a href="/habits">Habit Stopper</a>
      <form action="/logout" method="POST" style="display:inline;">
        <button type="submit" class="btn small danger" style="margin-left:16px;">Logout</button>
      </form>
    </div>
  </nav>

  <div class="container">

  <script>
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('navLinks');

    hamburger.addEventListener('click', () => {
      hamburger.classList.toggle('active');
      navLinks.classList.toggle('open');
    });
  </script>
</body>
</html>