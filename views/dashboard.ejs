<%- include('partials/header') %>

<style>
  :root {
    --bg-color: #f7f9fc;
    --card-bg: #ffffff;
    --primary: #4a6cf7;
    --primary-light: #eef1ff;
    --text-dark: #1f2937;
    --text-muted: #6b7280;
    --border-color: #e5e7eb;
    --success: #16a34a;
    --danger: #dc2626;
    --pending: #d97706;
    --shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    --shadow-hover: 0 6px 16px rgba(0, 0, 0, 0.10);
  }

  body {
    background-color: var(--bg-color);
    color: var(--text-dark);
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  .dashboard-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 20px;
  }

  h1 {
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 4px;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 28px;
  }

  .subtitle strong {
    color: var(--primary);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .stat-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 22px 24px;
    box-shadow: var(--shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .stat-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .stat-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-bottom: 10px;
  }

  .big-num {
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--primary);
    margin: 0 0 10px 0;
    line-height: 1;
  }

  .stat-card p:not(.big-num) {
    font-size: 0.9rem;
    color: var(--text-dark);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-right: 12px;
    font-size: 0.88rem;
  }

  .badge.success { color: var(--success); font-weight: 600; }
  .badge.danger  { color: var(--danger); font-weight: 600; }
  .badge.pending { color: var(--pending); font-weight: 600; }

  @media (max-width: 600px) {
    h1 { font-size: 1.5rem; }
    .big-num { font-size: 2rem; }
    .dashboard-container { padding: 20px 14px; }
  }
</style>

<div class="dashboard-container">
 
  <p class="subtitle">Year: <%= currentYear %> • Theme: <strong><%= stats.currentTheme %></strong></p>

  <div class="card-grid">
    <div class="stat-card">
      <h3>Achievements</h3>
      <p class="big-num"><%= stats.totalAchievements %></p>
      <p>
        <span class="badge success">✅ <%= stats.achieved %> achieved</span>
        <span class="badge danger">❌ <%= stats.failed %> failed</span>
        <span class="badge pending">⏳ <%= stats.pending %> pending</span>
      </p>
    </div>

    <div class="stat-card">
      <h3>Active Rules</h3>
      <p class="big-num"><%= stats.activeRules %></p>
    </div>

    <div class="stat-card">
      <h3>Habits Being Stopped</h3>
      <p class="big-num"><%= stats.activeHabits %></p>
    </div>
  </div>
</div>