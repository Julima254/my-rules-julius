<%- include('partials/header') %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Daily Routine Timetable</title>
  <style>
    :root {
      --blue: #1597d4;
      --ink: #0d3b4a;
      --line: #14586b;
      --orange: #f6a21e;
      --cream: #fde6bb;
      --sky: #dbe8f6;
      --green: #7fdc8a;
      --yellow: #fff200;
      --black: #0a0a0a;
      --col: 132px;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 18px 14px 40px;
      font-family: "Trebuchet MS", "Segoe UI", Arial, sans-serif;
      background: #eef3f6; color: var(--ink);
    }
    .wrap { max-width: 1200px; margin: 0 auto; }

    h1 {
      margin: 0 0 10px; text-align: center;
      font-family: Impact, "Arial Black", sans-serif; font-weight: 900;
      font-size: clamp(26px, 5vw, 44px); letter-spacing: .5px;
      color: var(--blue);
      text-shadow: 2px 2px 0 #fff, 3px 3px 0 rgba(0,0,0,.12);
    }

    .datebar {
      display: flex; flex-wrap: wrap; gap: 10px 18px;
      align-items: center; justify-content: space-between;
      margin-bottom: 12px; font-weight: 700;
    }
    .datebar form { display: flex; gap: 8px; align-items: center; margin: 0; }
    .datebar input[type=date] {
      font: inherit; padding: 5px 8px; border: 2px solid var(--line);
      border-radius: 6px; background: #fff; color: var(--ink);
    }
    .btn {
      font: inherit; font-weight: 700; cursor: pointer;
      border: 2px solid var(--line); background: #fff; color: var(--ink);
      padding: 6px 12px; border-radius: 6px; text-decoration: none;
    }
    .btn:hover { background: var(--cream); }
    .btn:focus-visible, input:focus-visible, button:focus-visible, a:focus-visible {
      outline: 3px solid var(--blue); outline-offset: 2px;
    }
    .btn.primary { background: var(--ink); color: #fff; }
    .btn.primary:hover { background: #0a2d39; }
    .btn.danger { border-color: #b3261e; color: #b3261e; }
    .btn.danger:hover { background: #fde8e6; }

    .scroll {
      overflow-x: auto; border: 4px solid var(--line);
      border-radius: 10px; background: #fff;
    }
    table.tt { border-collapse: collapse; width: 100%; table-layout: fixed; }
    .tt th, .tt td { border: 2px solid var(--line); padding: 0; vertical-align: middle; }

    .tt thead th {
      background: var(--black); color: #fff; height: 56px;
      font-size: 15px; font-weight: 700; line-height: 1.25; width: var(--col);
    }
    .tt thead th.corner { width: 150px; }
    .tt thead th.corner span {
      display: inline-block; padding: 6px 12px; border-radius: 999px;
      background: var(--blue); font-family: Impact, "Arial Black", sans-serif;
      letter-spacing: 1px;
    }
    .tt thead th.addhead { width: 86px; }
    .slothead { cursor: pointer; }
    .slothead:hover, .slothead:focus-visible { background: #26363d; }
    .slothead .to { display: block; border-top: 1px solid #777; margin-top: 3px; padding-top: 3px; }

    td.day {
      width: 92px; background: var(--orange); text-align: center;
      font-family: Impact, "Arial Black", sans-serif; font-size: 24px;
      letter-spacing: 1px; color: #7a1c10;
    }
    td.day small {
      display: block; font-family: "Trebuchet MS", Arial, sans-serif;
      font-size: 13px; letter-spacing: 0; color: var(--ink); margin-top: 4px;
    }
    td.lab {
      width: 58px; text-align: center; font-size: 12px; font-weight: 700;
      background: #fff; color: var(--ink);
    }

    td.task { background: var(--cream); height: 92px; }
    td.done { background: var(--sky); height: 46px; text-align: center; }
    td.note { background: var(--green); height: 54px; }

    td.task button.cell {
      all: unset; box-sizing: border-box; display: flex; width: 100%; height: 100%;
      align-items: center; justify-content: center; text-align: center;
      padding: 8px; font-weight: 700; font-size: 15px; line-height: 1.2;
      cursor: pointer; overflow-wrap: anywhere;
    }
    td.task button.cell:hover { background: rgba(255,255,255,.45); }
    td.task button.cell:focus-visible { outline: 3px solid var(--blue); outline-offset: -3px; }
    td.task.finished button.cell { text-decoration: line-through; opacity: .55; }

    td.done input[type=checkbox] { width: 24px; height: 24px; accent-color: var(--ink); cursor: pointer; }
    td.note input[type=text] {
      width: 100%; height: 100%; border: 0; background: transparent;
      padding: 6px 8px; font: inherit; font-size: 13px; color: var(--ink);
    }
    td.note input[type=text]::placeholder { color: #2f6f3b; }
    td.note input[type=text]:focus { background: rgba(255,255,255,.5); outline: none; }
    td.note.saved { background: #a8f0b1; }

    td.addcol { background: var(--yellow); text-align: center; }
    td.addcol button {
      all: unset; cursor: pointer; width: 100%; height: 100%;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      font-family: Impact, "Arial Black", sans-serif; font-size: 44px; line-height: 1;
      color: var(--ink);
    }
    td.addcol button span { font-size: 13px; font-family: "Trebuchet MS", Arial, sans-serif; font-weight: 700; margin-top: 4px; }
    td.addcol button:hover { background: #fff77a; }
    td.addcol button:focus-visible { outline: 3px solid var(--blue); outline-offset: -3px; }

    dialog {
      border: 4px solid var(--line); border-radius: 10px; padding: 0;
      width: min(420px, 92vw); color: var(--ink);
    }
    dialog::backdrop { background: rgba(10,20,25,.55); }
    dialog .head {
      background: var(--black); color: #fff; padding: 12px 16px;
      font-family: Impact, "Arial Black", sans-serif; letter-spacing: .5px; font-size: 20px;
    }
    dialog form { padding: 16px; display: grid; gap: 12px; margin: 0; }
    dialog .times { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    dialog label { display: grid; gap: 4px; font-weight: 700; font-size: 14px; }
    dialog input[type=time], dialog input[type=text] {
      font: inherit; padding: 8px 10px; border: 2px solid var(--line); border-radius: 6px;
    }
    dialog .actions { display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap; }
    dialog .actions .spacer { margin-right: auto; }

    @media (max-width: 600px) {
      :root { --col: 118px; }
      td.day { font-size: 18px; width: 64px; }
      td.lab { width: 44px; font-size: 11px; }
      .tt thead th.corner { width: 108px; }
    }
  </style>
</head>
<body>
<%
  const fmt = t => (t || '').replace(':', '.').replace(/^0/, ''); // "08:20" -> "8.20"
  const d = new Date(date + 'T00:00:00Z');
  const dayName = d.toLocaleDateString('en-GB', { weekday: 'short', timeZone: 'UTC' }).toUpperCase();
  const prettyDate = d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
%>
<div class="wrap">
  <h1>DAILY ROUTINE TIMETABLE</h1>

  <div class="datebar">
    <form action="/routine" method="get">
      <label for="datePick">Date</label>
      <input type="date" id="datePick" name="date" value="<%= date %>">
      <button class="btn" type="submit">Go</button>
    </form>
  </div>

  <div class="scroll">
    <table class="tt">
      <thead>
        <tr>
          <th class="corner" colspan="2"><span>ROUTINE</span></th>
          <% slots.forEach(s => { %>
            <th class="slothead" tabindex="0" role="button" title="Edit this slot"
                data-edit data-id="<%= s._id %>" data-hour="<%= s.hour %>"
                data-end="<%= s.endHour %>" data-task="<%= s.task %>">
              <%= fmt(s.hour) %>
              <span class="to"><%= fmt(s.endHour) %></span>
            </th>
          <% }) %>
          <th class="addhead">ADD</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="day" rowspan="3"><%= dayName %><small><%= prettyDate %></small></td>
          <td class="lab">Task</td>
          <% slots.forEach(s => {
               const c = checksMap[s._id.toString()] || { done: false, comment: '' }; %>
            <td class="task <%= c.done ? 'finished' : '' %>" data-slot="<%= s._id %>">
              <button type="button" class="cell" data-edit data-id="<%= s._id %>"
                      data-hour="<%= s.hour %>" data-end="<%= s.endHour %>"
                      data-task="<%= s.task %>"><%= s.task || 'Add task' %></button>
            </td>
          <% }) %>
          <td class="addcol" rowspan="3">
            <button type="button" id="addBtn" aria-label="Add a time slot">+<span>Add slot</span></button>
          </td>
        </tr>
        <tr>
          <td class="lab">Done</td>
          <% slots.forEach(s => {
               const c = checksMap[s._id.toString()] || { done: false, comment: '' }; %>
            <td class="done">
              <input type="checkbox" data-check="<%= s._id %>" aria-label="Mark done" <%= c.done ? 'checked' : '' %>>
            </td>
          <% }) %>
        </tr>
        <tr>
          <td class="lab">Note</td>
          <% slots.forEach(s => {
               const c = checksMap[s._id.toString()] || { done: false, comment: '' }; %>
            <td class="note">
              <input type="text" data-note="<%= s._id %>" value="<%= c.comment %>" placeholder="Note" aria-label="Note">
            </td>
          <% }) %>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Add / edit dialog -->
<dialog id="slotDialog">
  <div class="head" id="dlgTitle">EDIT SLOT</div>
  <form id="slotForm" method="post" action="/routine">
    <input type="hidden" name="date" value="<%= date %>">
    <div class="times">
      <label>Start <input type="time" name="hour" id="fHour" required></label>
      <label>End <input type="time" name="endHour" id="fEnd" required></label>
    </div>
    <label>Task
      <input type="text" name="task" id="fTask" required maxlength="120" autocomplete="off">
    </label>
    <div class="actions">
      <button type="submit" class="btn danger spacer" id="delBtn" formnovalidate
              onclick="return confirm('Delete this slot?')">Delete</button>
      <button type="button" class="btn" id="cancelBtn">Cancel</button>
      <button type="submit" class="btn primary">Save changes</button>
    </div>
  </form>
</dialog>

<script>
  const DATE = "<%= date %>";
  const dlg = document.getElementById('slotDialog');
  const form = document.getElementById('slotForm');
  const delBtn = document.getElementById('delBtn');

  function openDialog(slot) {
    if (slot) {
      document.getElementById('dlgTitle').textContent = 'EDIT SLOT';
      form.action = '/routine/' + slot.id + '/edit';
      delBtn.style.display = '';
      delBtn.setAttribute('formaction', '/routine/' + slot.id + '/delete');
      document.getElementById('fHour').value = slot.hour || '';
      document.getElementById('fEnd').value = slot.end || '';
      document.getElementById('fTask').value = slot.task || '';
    } else {
      document.getElementById('dlgTitle').textContent = 'ADD SLOT';
      form.action = '/routine';
      delBtn.style.display = 'none';
      delBtn.removeAttribute('formaction');
      document.getElementById('fHour').value = '';
      document.getElementById('fEnd').value = '';
      document.getElementById('fTask').value = '';
    }
    dlg.showModal();
    document.getElementById(slot ? 'fTask' : 'fHour').focus();
  }

  document.querySelectorAll('[data-edit]').forEach(el => {
    const open = () => openDialog({
      id: el.dataset.id, hour: el.dataset.hour, end: el.dataset.end, task: el.dataset.task
    });
    el.addEventListener('click', open);
    el.addEventListener('keydown', e => {
      if ((e.key === 'Enter' || e.key === ' ') && el.tagName === 'TH') { e.preventDefault(); open(); }
    });
  });
  document.getElementById('addBtn').addEventListener('click', () => openDialog(null));
  document.getElementById('cancelBtn').addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });

  // Save done + note for this date without reloading
  function saveCheck(id) {
    const box = document.querySelector('[data-check="' + id + '"]');
    const note = document.querySelector('[data-note="' + id + '"]');
    const body = new URLSearchParams({ date: DATE, comment: note.value });
    if (box.checked) body.append('done', 'on');

    fetch('/routine/' + id + '/check', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
      body
    }).then(r => {
      if (!r.ok) throw new Error('Save failed');
      const cell = document.querySelector('td.task[data-slot="' + id + '"]');
      if (cell) cell.classList.toggle('finished', box.checked);
      const td = note.closest('td');
      td.classList.add('saved');
      setTimeout(() => td.classList.remove('saved'), 600);
    }).catch(() => alert('Could not save. Please try again.'));
  }

  document.querySelectorAll('[data-check]').forEach(el =>
    el.addEventListener('change', () => saveCheck(el.dataset.check)));
  document.querySelectorAll('[data-note]').forEach(el => {
    el.addEventListener('change', () => saveCheck(el.dataset.note));
    el.addEventListener('keydown', e => { if (e.key === 'Enter') el.blur(); });
  });
</script>
</body>
</html>