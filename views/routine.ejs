<%- include('partials/header') %>

<style>
  .routine-page {
    --bg: #f5f6f8;
    --card-bg: #ffffff;
    --border: #e2e5ea;
    --text: #1f2430;
    --text-muted: #6b7280;
    --primary: #2563eb;
    --primary-hover: #1d4ed8;
    --success-bg: #f0fdf4;
    --success-border: #bbf7d0;
    --success-text: #15803d;
    --danger: #dc2626;
    --radius: 8px;

    box-sizing: border-box;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    width: 100%;
    min-height: 100vh;
    padding: 24px 32px 60px;
  }

  .routine-page *, .routine-page *::before, .routine-page *::after {
    box-sizing: border-box;
  }

  .routine-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 20px;
  }

  .routine-top h1 {
    font-size: 22px;
    font-weight: 600;
    margin: 0;
  }

  .date-picker {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .date-picker input[type="date"] {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 6px 10px;
    font-size: 14px;
    background: var(--card-bg);
  }

  .add-btn {
    border: none;
    border-radius: var(--radius);
    background: var(--primary);
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    padding: 9px 16px;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .add-btn:hover { background: var(--primary-hover); }

  /* Add slot panel */
  .add-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.2s ease;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 0;
  }
  .add-panel.open {
    max-height: 220px;
    margin-bottom: 20px;
  }
  .add-panel-inner {
    padding: 16px 20px;
  }
  .add-panel h3 {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 0 0 12px;
  }
  .add-form-row {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .field label {
    font-size: 12px;
    color: var(--text-muted);
  }
  .field input {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 8px 10px;
    font-size: 14px;
  }
  .field-task { flex: 1; min-width: 200px; }
  .field-task input { width: 100%; }

  /* Table-style list */
  .list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .routine-row {
    display: grid;
    grid-template-columns: 190px 1fr 260px;
    align-items: center;
    gap: 16px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 16px;
  }

  .routine-row.success {
    background: var(--success-bg);
    border-color: var(--success-border);
  }

  /* Left: time */
  .col-time {
    font-size: 13px;
    font-weight: 600;
    color: var(--primary);
    background: #eef2ff;
    border-radius: 6px;
    padding: 6px 10px;
    text-align: center;
    white-space: nowrap;
  }
  .success .col-time {
    color: var(--success-text);
    background: #dcfce7;
  }

  /* Center: editable task */
  .col-task input[type="text"] {
    width: 100%;
    border: 1px solid transparent;
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    padding: 6px 8px;
    border-radius: 6px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .col-task input[type="text"]:hover {
    background: #fafbfc;
  }
  .col-task input[type="text"]:focus {
    outline: none;
    border-color: var(--border);
    background: #fff;
  }

  /* Right: check + comment + more */
  .col-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-end;
  }

  .actions-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .comment-preview {
    font-size: 12px;
    color: var(--text-muted);
    font-style: italic;
    max-width: 160px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .more-toggle {
    border: none;
    background: none;
    color: var(--primary);
    font-size: 12px;
    cursor: pointer;
    padding: 2px 4px;
  }
  .more-toggle:hover { text-decoration: underline; }

  .more-panel {
    display: none;
    width: 100%;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    margin-top: 4px;
  }
  .more-panel.open { display: flex; }

  .comment-input {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 7px 10px;
    font-size: 13px;
  }

  .more-panel-buttons {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  .btn {
    border: none;
    border-radius: var(--radius);
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .btn-save {
    background: #eef2ff;
    color: var(--primary);
    border: 1px solid #c7d2fe;
  }
  .btn-save:hover { background: #e0e7ff; }
  .btn-danger {
    background: #fff;
    color: var(--danger);
    border: 1px solid #fca5a5;
  }
  .btn-danger:hover { background: var(--danger); color: #fff; }

  /* Responsive */
  @media (max-width: 800px) {
    .routine-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .col-time { text-align: left; width: fit-content; }
    .col-actions { align-items: stretch; }
    .actions-top { justify-content: space-between; }
    .comment-preview { max-width: none; }
    .add-form-row { flex-direction: column; align-items: stretch; }
    .field-task { min-width: 0; }
  }

  @media (max-width: 480px) {
    .routine-page { padding: 16px; }
  }
</style>

<div class="routine-page">
  <div class="routine-top">
    <h1>Daily Routine</h1>

    <form method="GET" action="/routine" class="date-picker">
      <label>Viewing date:</label>
      <input type="date" name="date" value="<%= date %>" onchange="this.form.submit()">
    </form>

    <button type="button" class="add-btn" onclick="toggleAddPanel()">+ Add Slot</button>
  </div>

  <div class="add-panel" id="addPanel">
    <div class="add-panel-inner">
      <h3>New Time Slot</h3>
      <form action="/routine" method="POST" class="add-form-row">
        <div class="field">
          <label>Start</label>
          <input type="time" name="hour" required>
        </div>
        <div class="field">
          <label>End</label>
          <input type="time" name="endHour" required>
        </div>
        <div class="field field-task">
          <label>Task</label>
          <input type="text" name="task" placeholder="Task for this slot" required>
        </div>
        <button type="submit" class="btn btn-save">Save Slot</button>
      </form>
    </div>
  </div>

  <div class="list">
    <% slots.forEach(s => {
         const check = checksMap[s._id.toString()] || { done: false, comment: '', task: '' };
         const taskValue = check.task || s.task;
         const rowId = s._id.toString();
    %>
      <div class="routine-row <%= check.done ? 'success' : '' %>">
        <div class="col-time"><%= s.hourLabel %></div>

        <div class="col-task">
          <form id="check-form-<%= rowId %>" action="/routine/<%= s._id %>/check" method="POST">
            <input type="hidden" name="date" value="<%= date %>">
            <input
              type="text"
              name="task"
              value="<%= taskValue %>"
              form="check-form-<%= rowId %>"
            >
          </form>
        </div>

        <div class="col-actions">
          <div class="actions-top">
            <% if (check.comment) { %>
              <span class="comment-preview" title="<%= check.comment %>"><%= check.comment %></span>
            <% } %>
            <label class="checkbox-label">
              <input
                type="checkbox"
                name="done"
                form="check-form-<%= rowId %>"
                <%= check.done ? 'checked' : '' %>
                onchange="document.getElementById('check-form-<%= rowId %>').submit()"
              >
              Done
            </label>
            <button type="button" class="more-toggle" onclick="toggleMore('<%= rowId %>')">More</button>
          </div>

          <div class="more-panel" id="more-<%= rowId %>">
            <input
              type="text"
              name="comment"
              class="comment-input"
              placeholder="Add a comment..."
              value="<%= check.comment %>"
              form="check-form-<%= rowId %>"
            >
            <div class="more-panel-buttons">
              <button type="submit" form="check-form-<%= rowId %>" class="btn btn-save">Save</button>
              <form action="/routine/<%= s._id %>?_method=DELETE" method="POST">
                <button type="submit" class="btn btn-danger">Delete</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<script>
  function toggleAddPanel() {
    document.getElementById('addPanel').classList.toggle('open');
  }

  function toggleMore(id) {
    document.getElementById('more-' + id).classList.toggle('open');
  }
</script>